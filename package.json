		"url": "https://github.com/jesseagleboy/emdash-plugin-indexnow/issues"
	},
	"homepage": "https://github.com/jesseagleboy/emdash-plugin-indexnow#readme",
	"type": "module",
	"main": "./index.mjs",
	"exports": {
		".": "./index.mjs",
		"./package.json": "./package.json"
	},
	"files": ["index.mjs", "submission.mjs", "README.md", "LICENSE"],
